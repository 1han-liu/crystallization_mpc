# InfluxDB first-start initialization.
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=change-me
DOCKER_INFLUXDB_INIT_ORG=crystallization-lab
DOCKER_INFLUXDB_INIT_BUCKET=crystallization
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=change-me

# Values used by the Python InfluxDB client after initialization.
# INFLUX_TOKEN must match DOCKER_INFLUXDB_INIT_ADMIN_TOKEN for this local setup.
INFLUX_TOKEN=change-me
INFLUX_ORG=crystallization-lab
INFLUX_BUCKET=crystallization
