# UI shown by Central and Gsensor.
# development: include diagnostic and offline-test tools.
# production: show only operator-facing features (safe default).
UI_MODE=production

# Host directory under which Central creates one subdirectory per experiment.
# Use forward slashes for Windows paths when running Docker Desktop.
EXPERIMENT_HOST_ROOT=C:/ExperimentData

# New folders use UTC + experiment label; run_id remains the stable identifier.
# On upgrade, stop services and migrate old system state before starting them.
# python -m crystallization_mpc.infra.storage_paths --root C:/ExperimentData --apply
EXPERIMENT_EXPORT_ENABLED=true
GRAFANA_EXPERIMENT_URL=http://localhost:3000/d/crystallization-mpc-analysis/crystallization-mpc-analysis
# Existing RabbitMQ: preserve BOTH the old data volume name and hostname.
# Inspect them before recreating the service. Do not run `down -v`.
# New installations use a project-scoped volume. Distinct Compose -p projects
# remain isolated unless RABBITMQ_DATA_VOLUME explicitly selects a shared name.
# RABBITMQ_DATA_VOLUME=<existing-volume-name>
# RABBITMQ_HOSTNAME=<existing-container-hostname>

# Interval in seconds between Gsensor scans of the selected experiment images.
GSENSOR_IMAGE_POLL_INTERVAL_S=1.0

# Keep false during normal experiments. When true, each Hough stage is written
# under the local Gsensor debug output root for algorithm diagnosis.
GSENSOR_HOUGH_DEBUG_ENABLED=false

# Gsensor publishes lifecycle status to Central through RabbitMQ in Docker.
GSENSOR_STATUS_PUBLISH_ENABLED=true

# Publish each valid/invalid growth-rate frame to Controller through RabbitMQ.
GSENSOR_SAMPLE_PUBLISH_ENABLED=true

# Persist each processed Gsensor frame to the gsensor_measurement series.
# Credentials, organization and bucket are loaded from config/influxdb.env.
GSENSOR_INFLUX_ENABLED=true

# Optional Controller algorithm adapter, using the Python module:Class format.
# CONTROLLER_ADAPTER=crystallization_mpc.apps.controller.algorithm.integration:CrystallizationControllerAdapter
CONTROLLER_ADAPTER=

# RabbitMQ process I/O; both remain disabled for numerical simulation.
# Start the device-facing services with: docker compose --profile process-io up -d
# Stop any active experiment before switching transport. See docs/process-io.md.
CONTROLLER_PROCESS_ENABLED=false
CONTROLLER_PROCESS_WRITE_ENABLED=false
PROCESS_DEVICE_ID=crystallizer
PROCESS_SAMPLE_MAX_AGE_S=5.0
PROCESS_STARTUP_TIMEOUT_S=10.0
PROCESS_COMMAND_TTL_S=5.0
PROCESS_WRITE_TIMEOUT_S=5.0
PROCESS_TELEMETRY_QUEUE=process.telemetry
PROCESS_RESULT_QUEUE=process.results
TELEGRAF_INTERVAL=1s
TELEGRAF_FLUSH_INTERVAL=1s
# Disk buffer persists across Telegraf process/container restarts. Per-metric
# fsync is disabled for 1 s collection latency; a host power failure can lose
# recent OS-buffered writes. Test timing before enabling this on lab hardware.
# This setting is literal in config/telegraf/telegraf.conf for Telegraf 1.40.1.

# Only Telegraf and opcua-writer connect to the device. These defaults describe
# one server endpoint with five nodes, not five separate server endpoints.
OPCUA_ENDPOINT=opc.tcp://host.docker.internal:62552
OPCUA_NAMESPACE_INDEX=2
OPCUA_T_J_SET_NODE=iCache.Temperature1
OPCUA_T_NODE=Local.iControl.Experiment1.Trends.Tr.Value
OPCUA_T_J_NODE=Local.iControl.Experiment1.Trends.Tj.Value
OPCUA_C_NODE=Local.iControl.Experiment1.Trends.load.Value
OPCUA_COUNT_MIDDLE_NODE=Local.iControl.Experiment1.Trends.count.Value
OPCUA_TIMEOUT_S=5.0
OPCUA_JACKET_MIN_K=253.15
OPCUA_JACKET_MAX_K=453.15
# Required by the RabbitMQ writer: false is rejected at startup.
OPCUA_VERIFY_WRITE=true
OPCUA_VERIFY_TOLERANCE_K=0.05
OPCUA_WRITER_QUEUE=opcua_writer.in

# Configure server-supported security and credentials before hardware use.
# Empty paths are valid for the isolated anonymous test server only.
OPCUA_AUTH_METHOD=Anonymous
OPCUA_USERNAME=
OPCUA_PASSWORD=
OPCUA_SECURITY_POLICY=None
OPCUA_SECURITY_MODE=None
OPCUA_CERT_HOST_ROOT=./config/telegraf/certs
# Paths below are container paths under the read-only certificate mount.
OPCUA_CERTIFICATE=
OPCUA_PRIVATE_KEY=
OPCUA_SERVER_CERTIFICATE=

# Persist real results returned by the Controller algorithm adapter. The
# token, organization and bucket are loaded from config/influxdb.env so the
# Controller and Gsensor always write to the same InfluxDB location. NoOp
# produces no Controller records.
CONTROLLER_INFLUX_ENABLED=true
CONTROLLER_INFLUX_URL=http://influxdb:8086

# Central exports applied runtime configuration changes as Grafana events to
# the same database. By default this follows CONTROLLER_INFLUX_ENABLED.
# Uncomment to override event export independently of Controller measurements.
# CENTRAL_RUNTIME_INFLUX_ENABLED=true
