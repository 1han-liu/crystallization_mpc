# UI shown by Central and Gsensor.
# development: include diagnostic and offline-test tools.
# production: show only operator-facing features (safe default).
UI_MODE=production

# Host directory under which Central creates one subdirectory per experiment.
# Use forward slashes for Windows paths when running Docker Desktop.
EXPERIMENT_HOST_ROOT=C:/ExperimentData

# Interval in seconds between Gsensor scans of the selected experiment images.
GSENSOR_IMAGE_POLL_INTERVAL_S=1.0

# Keep false during normal experiments. When true, each Hough stage is written
# under the local Gsensor debug output root for algorithm diagnosis.
GSENSOR_HOUGH_DEBUG_ENABLED=false

# Gsensor publishes lifecycle status to Central through RabbitMQ in Docker.
GSENSOR_STATUS_PUBLISH_ENABLED=true

# Publish each valid/invalid growth-rate frame to Controller through RabbitMQ.
GSENSOR_SAMPLE_PUBLISH_ENABLED=true

# Persist each processed Gsensor frame to the gsensor_measurement series.
# Credentials, organization and bucket are loaded from config/influxdb.env.
GSENSOR_INFLUX_ENABLED=true

# Optional translated Controller adapter, using the Python module:Class format.
# After the teammate completes matlab_controller.py, use:
# CONTROLLER_ADAPTER=crystallization_mpc.apps.controller.translated.adapter:MatlabControllerAdapter
CONTROLLER_ADAPTER=

# Real equipment I/O translated from the MATLAB Controller. Keep this false
# until the port-62552 server and safety limits have been verified on site.
CONTROLLER_OPCUA_ENABLED=false
CONTROLLER_OPCUA_ENDPOINT=opc.tcp://host.docker.internal:62552
CONTROLLER_OPCUA_NAMESPACE_INDEX=2
CONTROLLER_OPCUA_T_J_SET_NODE=iCache.Temperature1
CONTROLLER_OPCUA_T_NODE=Local.iControl.Experiment1.Trends.Tr.Value
CONTROLLER_OPCUA_T_J_NODE=Local.iControl.Experiment1.Trends.Tj.Value
CONTROLLER_OPCUA_C_NODE=Local.iControl.Experiment1.Trends.load.Value
CONTROLLER_OPCUA_COUNT_MIDDLE_NODE=Local.iControl.Experiment1.Trends.count.Value
CONTROLLER_OPCUA_TIMEOUT_S=5.0
CONTROLLER_OPCUA_JACKET_MIN_K=253.15
CONTROLLER_OPCUA_JACKET_MAX_K=453.15
CONTROLLER_OPCUA_VERIFY_WRITE=true
CONTROLLER_OPCUA_VERIFY_TOLERANCE_K=0.05

# Persist real results returned by the translated Controller adapter. The
# token, organization and bucket are loaded from config/influxdb.env so the
# Controller and Gsensor always write to the same InfluxDB location. NoOp
# produces no Controller records.
CONTROLLER_INFLUX_ENABLED=true
CONTROLLER_INFLUX_URL=http://influxdb:8086
